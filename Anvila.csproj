<Project Sdk="Microsoft.NET.Sdk">
  <!-- Anvila: the builder core shared by the Revare and Mielia front ends (syntax tree, type model,
       declaration/verification/lowering/instantiation/collection passes, the LLVM emitter, the build
       driver, daemon, JIT and language server). Each language's lexer and command line live in its own
       project (..\Revare, ..\Mielia), which registers its language rules here at startup. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.5.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Anvila, the builder core shared by Revare and Mielia.</Description>
    <!-- The builder runs optimized in every configuration: bin/Debug is what daily builds, the test suites and
         the editors' language servers run. Build with -p:Optimize=false to step through it in a debugger. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- The native runtime is Ingrid's (..\Ingrid\native). -->
  <PropertyGroup>
    <IngridNativeDir>$(MSBuildProjectDirectory)\..\Ingrid\native</IngridNativeDir>
    <NativeLibraryPath>$(IngridNativeDir)\build</NativeLibraryPath>
  </PropertyGroup>

  <!-- The front ends and the tests use the builder's internal members. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Revare"/>
    <InternalsVisibleTo Include="Mielia"/>
    <InternalsVisibleTo Include="Revare.Tests"/>
    <InternalsVisibleTo Include="Mielia.Tests"/>
  </ItemGroup>

  <!-- Kill any lingering resident daemon BEFORE the build. A daemon (spawned by a non-jit build/run)
       runs the OLD builder and holds an open handle to it, so a subsequent `dotnet build` cannot overwrite
       it (MSB3021 "being used by another process"). The daemon is stale after any C# change anyway (it
       would be shut down as stale on the next ping), so killing it here is free — the next run cold-spawns
       a fresh warm daemon. Best-effort (ContinueOnError): no daemon → no-op. -->
  <Target Name="StopResidentDaemonBeforeBuild" BeforeTargets="BeforeBuild"
          Condition="'$(OS)' == 'Windows_NT' And '$(KeepResidentDaemons)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\stop-resident-daemon.ps1&quot;"
          ContinueOnError="true"/>
  </Target>

  <!-- Build Ingrid's native libraries before the builder compiles, once the Lapila builder is built: the runtime
       library has code written in Lapila (Ingrid/runtime-lapila), which CMake compiles with it (LAPILA_DLL). -->
  <PropertyGroup>
    <LapilaBuilderDll>$(MSBuildProjectDirectory)\..\Lapila\bin\$(Configuration)\net10.0\lapila.dll</LapilaBuilderDll>
  </PropertyGroup>
  <Target Name="BuildNativeLibraries" AfterTargets="ResolveProjectReferences" BeforeTargets="CoreCompile"
          Condition="'$(SkipNative)' != 'true'">
    <Exec Command="&quot;$(IngridNativeDir)\build.bat&quot;" WorkingDirectory="$(IngridNativeDir)" Condition="'$(OS)' == 'Windows_NT'"
          EnvironmentVariables="LAPILA_DLL=$(LapilaBuilderDll)"/>
    <Exec Command="bash &quot;$(IngridNativeDir)/build.sh&quot;" WorkingDirectory="$(IngridNativeDir)" Condition="'$(OS)' != 'Windows_NT'"
          EnvironmentVariables="LAPILA_DLL=$(LapilaBuilderDll)"/>
  </Target>

  <ItemGroup>
    <PackageReference Include="DebugUtils.CSharp" Version="1.8.0"/>
    <PackageReference Include="LLVMSharp" Version="22.1.8"/>
    <!-- The LLVM-C library the in-process JIT loads, the same version as the bindings above. Only the
         host's runtime package is pulled, so a build carries one native libLLVM, not every platform's. -->
    <PackageReference Include="libLLVM.runtime.linux-x64" Version="22.1.8"
                      Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'"/>
    <PackageReference Include="libLLVM.runtime.linux-arm64" Version="22.1.8"
                      Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'"/>
    <PackageReference Include="libLLVM.runtime.win-x64" Version="22.1.8"
                      Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'"/>
    <PackageReference Include="libLLVM.runtime.win-arm64" Version="22.1.8"
                      Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'"/>
    <PackageReference Include="libLLVM.runtime.osx-arm64" Version="22.1.8"
                      Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'"/>
    <PackageReference Include="Tomlyn" Version="0.17.0"/>
  </ItemGroup>

  <!-- The Lapila backend (src/9.LapilaEmit) builds through the Lapila builder and ships its standard
       library next to the builder, where LapilaBackend looks for it (lapila-stdlib/). The reference does not flow
       on to the executables (PrivateAssets): Lapila is an executable project, and a second, runtime-specific build
       of it through a self-contained publish would put two copies of its apphost, deps.json and runtimeconfig.json
       in the package (NETSDK1152). lapila.dll still reaches the executables as Anvila's dependency. -->
  <ItemGroup>
    <ProjectReference Include="..\Lapila\Lapila.csproj" PrivateAssets="all"/>
    <Content Include="..\Lapila\Standard\**\*.lpa" LinkBase="lapila-stdlib" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
